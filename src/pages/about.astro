---
import Experience from "@components/Sections/About/Experience.astro";
import Hero from "@components/Sections/About/Hero.astro";
import MainStack from "@components/Sections/About/MainStack.astro";
import Interests from "@components/Sections/About/Interests.astro";
import Path from "@components/Sections/About/Path.astro";
import Stack from "@components/Sections/About/Stack.astro";
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Sobre mí — ${siteData.name}`}
  description="Andres Ramos, desarrollador de software de Pitalito, Huila. Backend, productos e inteligencia artificial."
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <Hero />
    <MainStack />
    <Interests />
    <Path />
    <Experience />
    <Stack />
  </div>
</BaseLayout>
