---
import BlogListing from "@components/Sections/Blog/BlogListing.astro";
import { getSortedPosts } from "@js/blogData";
import { ALL_PAGE_SIZE } from "@js/postCards";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const count = (await getSortedPosts()).length;
  const pages = Math.ceil(count / ALL_PAGE_SIZE);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.params;
---

<BlogListing mode="todos" view="" page={Number(page)} />
