---
// Blog listing (/blog/). Thin route shell: owns BaseLayout + SEO and composes the Figma
// "blog-listing-page" frame (node 76:4) — the BlogHero panel + the shared CardGrid, fed from the
// `blog` collection (newest first, drafts dropped). Same `.site-container` shell/rhythm as the other
// pages. This is the page the header nav's BLOG link points at.
import BlogHero from "@components/Sections/Blog/BlogHero.astro";
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import siteData from "@config/siteData.json";
import { getSortedPosts } from "@js/blogData";
import { toPostCard } from "@js/postCards";
import BaseLayout from "@layouts/BaseLayout.astro";

const cards = (await getSortedPosts()).map(toPostCard);
---

<BaseLayout
  title={`Artículos — ${siteData.name}`}
  description="Temas y aprendizajes sobre software, tecnología, inteligencia artificial, metodologías y tecnología cloud."
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <BlogHero />
    <CardGrid headingId="blog-hero-heading" items={cards} />
  </div>
</BaseLayout>
