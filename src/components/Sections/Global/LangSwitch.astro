---
// ES / EN, same height as the theme toggle, on the left of the header.
---

<div class="flex items-center gap-2" data-lang-switch>
  <button type="button" data-set-lang="es" class="pixel-btn h-9 px-2 text-[10px] leading-none" aria-pressed="true">
    ES
  </button>
  <button type="button" data-set-lang="en" class="pixel-btn h-9 px-2 text-[10px] leading-none" aria-pressed="false">
    EN
  </button>
</div>
