---
// About hero. Name, origin, portrait, and contact links.
import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
import { PixelIcon, type PixelIconName } from "@components/svg/pixel-icons";
import { PixelPanel } from "@components/ui/pixel-panel";
import portrait from "@images/andres-ramos.jpg";

const highlight = "text-info font-bold";

const links: readonly {
  label: string;
  href: string;
  color: string;
  icon: PixelIconName;
}[] = [
  {
    label: "GitHub",
    href: "https://github.com/sakaramos",
    color: "text-success-700 hover:text-info dark:text-success dark:hover:text-info",
    icon: "github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/sakaramos/",
    color: "text-info hover:text-success",
    icon: "linkedin",
  },
  {
    label: "Email",
    href: "mailto:andfera201@gmail.com",
    color: "text-secondary-700 hover:text-info dark:text-secondary dark:hover:text-info",
    icon: "email",
  },
  {
    label: "WhatsApp",
    href: "https://wa.me/573172116762",
    color: "text-success-700 hover:text-info dark:text-success dark:hover:text-info",
    icon: "whatsapp",
  },
];
---

<HeroPanel
  headingId="about-hero-heading"
  tagline="Sobre mí"
  taglineEn="About me"
  heading="Soy Andres Ramos"
  headingEn="I'm Andres Ramos"
>
  <div class="flex w-full flex-col items-center gap-6 md:flex-row md:items-start md:justify-between">
    <div class="text-muted-foreground flex flex-col gap-4 text-base leading-relaxed">
      <p class="lang-es">
        Soy <span class={highlight}>desarrollador de software</span> con más de 4 años de experiencia,
        sobre todo en backend. Soy de Pitalito, Huila.
      </p>
      <p class="lang-en">
        I'm a <span class={highlight}>software developer</span> with more than 4 years of experience,
        mostly in backend. I'm from Pitalito, Huila.
      </p>
      <p class="lang-es">
        Ahora estoy usando la <span class={highlight}>inteligencia artificial</span> para cambiar la forma
        en que se construye software. Me importa crear productos, liderar el trabajo técnico, escribir
        código limpio y llevarlo a la nube.
      </p>
      <p class="lang-en">
        I'm using <span class={highlight}>artificial intelligence</span> to change how software is built.
        I care about creating products, leading the technical work, writing clean code, and shipping it
        to the cloud.
      </p>
      <p class="lang-es">
        Fuera de la tecnología, levanto pesas, escucho música, leo y sigo lo que me despierta curiosidad.
      </p>
      <p class="lang-en">
        Outside of technology, I lift weights, listen to music, read, and follow whatever makes me curious.
      </p>
    </div>
    <img
      src={portrait.src}
      width={portrait.width}
      height={portrait.height}
      alt="Andres Ramos"
      class="border-border shadow-pixel aspect-square w-40 shrink-0 border-4 object-cover object-top sm:w-44 md:w-48"
    />
  </div>

  <PixelPanel
    class="bg-muted mt-2 flex w-full flex-col items-center gap-3 p-4 text-xs sm:flex-row sm:justify-between sm:gap-4 sm:text-sm"
  >
    {
      links.map((link, i) => (
        <Fragment>
          {i > 0 && <span class="bg-base-400 hidden h-3.5 w-1 shrink-0 sm:block" aria-hidden="true" />}
          <a
            href={link.href}
            class:list={["font-display flex items-center gap-2 uppercase", link.color]}
            {...(link.href.startsWith("http")
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <PixelIcon name={link.icon} size="lg" />
            {link.label}
          </a>
        </Fragment>
      ))
    }
  </PixelPanel>
</HeroPanel>
